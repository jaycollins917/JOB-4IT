<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job 4IT</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/script.js" defer></script>
</head>
<body>

    <div class="bandeau">
        <h1 class="rgb-title">JOB 4IT</h1>
    
        <!--- Le bouton statistiques -->
        <a href="/stats">
            <button id="btn-stats">STATISTIQUES</button>
        </a>

        <!--- Le bouton connexion -->

        <button id="btn-connex">CONNEXION</button>
        <div class="tooltip-box">
            Se connecte à l'API data.gouv, récupère les nouvelles annonces, met à jour la base de données et rafraîchit le tableau de cette page.
        </div>

        
        <!--- Le bouton supprimer entrées BD -->
        <form action="/supp-db" method="POST" class="tooltip-wrapper">
            <button type="submit" id="btn-supp">SUPP BD</button>
            <div class="tooltip-box">
                En vue de tests, ce bouton supprime les annonces de code ROM 1810 dans la bd, et réactualise la page.
                <br> Ainsi, quand on clique sur connexion, on voit réellement les nouvelles annonces.
            </div>
        </form>

        <!-- Barre progression de récupération des annonces (masquée par défaut) -->
        <div id="progress-container">
            <div id="progress-label">Progression : 0 / 0</div>
            <div class="progress-track">
                <div id="progress-bar"></div>
            </div>
        </div>
        <div id="progress-fin"></div>

    </div>

    <!-- Le deuxième bandeau-->

    <div class="header-stats">
        <h1>Site d'offres d'emploi et de statistiques IT</h1>
        <div class="stats-bar">
            <span><emoji>🥷</emoji> <strong><%= totalAnnonces %></strong> Offres totales</span>
            <span><emoji>🌅</emoji> <strong><%= totalActives %></strong> Actives</span>
            <span><emoji>🏢</emoji> <strong><%= totalEmployeurs %></strong> Employeurs</span>
        </div>
    </div>

    <!-- Le tableau d'offres d'emploi -->
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Créée le</th>
                    <th>Titre</th>
                    <th>Entreprise</th>
                    <th>Contrat</th>
                    <th>Niveau<br>d'étude</th>
                    <th>Diplôme</th>
                    <th>Statut</th>
                    <th>Code ROME</th>
                </tr>
            </thead>
            <tbody>
                <% if (offres.length > 0) { %>
                    <% offres.forEach(offre => { %>
                        <tr onclick="window.open('/offre/<%= offre.uuid %>', '_blank')" style="cursor: pointer;">
                            <td><%= offre.created_at %></td>
                            <td><%= offre.titre %></td>
                            <td><%= offre.enseigne %></td>
                            <td style="text-align: center;"><%= offre.type_contrat %></td>
                            <td style="text-align: center;"><%= offre.niveau_etude %></td>
                            <td><%= offre.diplome %></td>
                            <td><%= offre.statut %></td>
                            <td><%= offre.rome_code %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="8" style="text-align: center; color: #777;">Aucune offre trouvée pour cette tranche de codes ROME.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    
    <script>
        // Ici on récupère le nombre total d'annonces actuel avant de se connecter à la base
        const anciennesOffres = parseInt("<%= totalAnnonces %>") || 0;
    </script>
    
</body>
</html>